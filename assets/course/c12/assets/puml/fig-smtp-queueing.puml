@startuml
actor Sender
participant "Source MTA\nQueue" as Queue
participant "Destination MTA" as Dest

Sender -> Queue : send message
Queue -> Queue : store message

loop retry with backoff
Queue -> Dest : delivery attempt
Dest --> Queue : 4xx temporary failure
end

Queue -> Dest : delivery attempt
Dest --> Queue : 250 OK

Queue -> Queue : remove from queue
@enduml
