@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam defaultFontSize 14

rectangle "SensorReading (mesaj .proto)" as msg {
  rectangle "sensor_id = 1\n\"temp-1\"" as f1
  rectangle "timestamp = 2\n1718000000" as f2
  rectangle "value = 3\n20.4" as f3
  rectangle "unit = 4\n\"celsius\"" as f4
}

rectangle "Encoding binar (pe fir)" as wire {
  rectangle "tag=1 | wire=2\n+ lungime + bytes" as w1
  rectangle "tag=2 | wire=0\n+ varint" as w2
  rectangle "tag=3 | wire=1\n+ 8 bytes IEEE 754" as w3
  rectangle "tag=4 | wire=2\n+ lungime + bytes" as w4
}

f1 --> w1
f2 --> w2
f3 --> w3
f4 --> w4

note right of wire
wire type 0 = varint
wire type 1 = 64-bit
wire type 2 = length-delimited
(nu exista nume de campuri pe fir)
end note

@enduml
